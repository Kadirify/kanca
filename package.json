{
  "name": "kanca",
  "private": true,
  "version": "0.1.0",
  "description": "Paste a suspicious email, see exactly why it is phishing.",
  "license": "MIT",
  "homepage": "https://kanca.kadirify.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kadirify/kanca.git"
  },
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @kanca/api dev",
    "dev:web": "pnpm --filter @kanca/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "analyze": "pnpm --filter @kanca/engine cli",
    "dev": "pnpm --filter @kanca/engine build && pnpm -r --parallel --filter @kanca/api --filter @kanca/web dev"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5"
}
